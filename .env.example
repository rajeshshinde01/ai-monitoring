# Local Docker monitoring
APP_PORT=8090
PROMETHEUS_PORT=9090
MONITORING_TARGET=docker
MONITORING_CONTAINER_PREFIX=mindspark-
LOG_TAIL_LINES=100
COLLECT_INTERVAL_SECONDS=5
PROMETHEUS_ENABLED=true
# PROMETHEUS_ALLOWED_HOSTS=prometheus.company.example
# PROMETHEUS_API_TOKEN=stored-in-your-secret-manager

# Optional local Ollama runtime (only when using docker-compose.ollama.yml).
# Docker Desktop on macOS runs this as a Linux container.
OLLAMA_PORT=11434


# Set only when using Kubernetes/OpenShift mode.
KUBERNETES_NAMESPACE=mindspark-official
# KUBECONFIG_PATH=/absolute/path/to/kubeconfig

# Optional Splunk REST API fallback for logs only. Kubernetes pod logs remain primary.
# Keep the API token outside this file, for example in a Kubernetes Secret.
SPLUNK_ENABLED=false
SPLUNK_BASE_URL=https://splunk.example.com:8089
SPLUNK_INDEX=main
SPLUNK_POD_FIELD=kubernetes.pod_name
SPLUNK_SCOPE_FIELD=kubernetes.namespace
SPLUNK_SCOPE_VALUE=mindspark-official
SPLUNK_LOOKBACK_MINUTES=15
# SPLUNK_ALLOWED_HOSTS=splunk.example.com
# SPLUNK_API_TOKEN=stored-in-your-secret-manager

# Local sign-in. Approved-domain users create a password on their first login.
# Add approved administrator emails locally; do not commit personal email addresses.
AUTH_MODE=local
AUTH_ALLOWED_EMAIL_DOMAIN=db.com
# AUTH_BOOTSTRAP_ADMIN_EMAILS=admin1@db.com,admin2@db.com
# Optional local emergency administrator. Disabled by default.
# Do not use a weak password such as admin/admin. Use a 12+ character value.
AUTH_ENABLE_BREAK_GLASS_ADMIN=false
AUTH_BREAK_GLASS_USERNAME=admin
# AUTH_BREAK_GLASS_PASSWORD=store-in-approved-local-secret
# Keep false for local HTTP. Set true for an HTTPS deployment.
AUTH_COOKIE_SECURE=false
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
# OIDC values are supplied only after the identity-provider application is registered.
# OIDC_ISSUER_URL=https://login.example.com/tenant/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=stored-in-your-secret-manager
# OIDC_REDIRECT_URL=https://pulseops.example.com/api/auth/oidc/callback
# AUTH_SESSION_SECRET=generate-a-long-random-value-for-the-oidc-state-cookie
